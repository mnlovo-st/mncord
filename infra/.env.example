# Copy to .env on the server (never commit .env). Fill the generated values with: node gen-secrets.mjs
DOMAIN=mncord.duckdns.org

POSTGRES_PASSWORD=
JWT_PRIVATE_JWK=
SECRETS_KEY=
FILES_SIGNING_KEY=

# Cloudflare Realtime (voice, video, Go Live). dash.cloudflare.com → Realtime → SFU → Create app.
# The secret stays here on the server; the app never sees it.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
# Optional: Cloudflare TURN key (helps people behind very strict networks)
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=

# Email (verification / password reset). Free option: a Gmail account with 2-Step Verification
# and an App Password:  smtps://YOUR_ADDRESS%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=mncord <YOUR_ADDRESS@gmail.com>

# DuckDNS (free domain) token, used by update-dns.sh
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=mncord
