{
	# Let's Encrypt contact (optional). Leave empty to not register an email.
	servers {
		protocols h1 h2 h3
	}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# REST API, gateway WebSocket, signed files, avatars
	reverse_proxy server:8787
	request_body {
		max_size 520MB
	}
}
