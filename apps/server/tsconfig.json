{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "verbatimModuleSyntax": true, "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
